# Copy this file to .env.local and fill in real values.
# Never commit .env.local or .env to version control.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/iloyalty?schema=public"

# ── OpenAI (for hotel/room description embeddings only) ────────────────────
# Used ONLY for embedding Hotel.description and Room.description.
# Never used to query, summarize, or interpret guest private data.
OPENAI_API_KEY="sk-placeholder-replace-me"

# ── Payment Provider (Stripe Connect example) ───────────────────────────────
# Stripe secret key — used to charge guests and route to hotel merchant accounts
STRIPE_SECRET_KEY="sk_test_placeholder-replace-me"
# Stripe webhook signing secret — used to verify and deduplicate webhook events
STRIPE_WEBHOOK_SECRET="whsec_placeholder-replace-me"

# ── Application ──────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ── PMS Connector ────────────────────────────────────────────────────────────
# Base URL of the pilot hotels' shared PMS API
PMS_API_BASE_URL="https://pms.example.com/api/v1"
PMS_API_KEY="placeholder-replace-me"

# ── Cron / Scheduler ─────────────────────────────────────────────────────────
# Secret used to authenticate internal cron trigger requests
CRON_SECRET="replace-with-a-long-random-string"
